PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/pharma_integrity?schema=public"
JWT_SECRET=change_me

RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
# Two independent attestors are required to anchor anything (propose + co-sign) - see
# AnchorRegistry.sol. This backend holds only the QA attestor's key and proposes
# anchors; the Auditor's key is held and operated entirely by the separate
# audit-service package (../audit-service), which independently authenticates its own
# users and co-signs - see audit-service/.env.example and
# docs/technical-disclosure.md §4.6/§4.9.
QA_ATTESTOR_PRIVATE_KEY=

# Test-only fixture, NOT read by the app itself (see src/env.ts) - should mirror
# whatever AUDITOR_ATTESTOR_PRIVATE_KEY is set to in ../audit-service/.env. Lets
# backend's automated tests simulate audit-service's on-chain co-sign action directly
# (test/chainHelpers.ts) without running that whole separate service.
TEST_AUDITOR_PRIVATE_KEY=

# Anomaly-detection thresholds (all optional - see src/anomaly/rules.ts for defaults).
# These are reasonable starting values, not tuned against real fraud data; override as
# real usage data justifies it, without a code change.
# ANOMALY_FAST_APPROVAL_FALLBACK_MS=60000
# ANOMALY_MIN_BASELINE_SAMPLE_SIZE=5
# ANOMALY_FAST_APPROVAL_Z_SCORE_THRESHOLD=-1.5
# ANOMALY_BUSINESS_HOUR_START=8
# ANOMALY_BUSINESS_HOUR_END=18
