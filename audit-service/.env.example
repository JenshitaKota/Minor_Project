PORT=4100
CORS_ORIGIN=http://localhost:5173

# A separate, least-privilege Postgres role - SELECT only on User, ManufacturingRecord,
# EquipmentCalibration (see ../scripts/create-audit-role.sql). Points at the SAME
# physical database the backend already migrates, via a different, read-only role.
AUDIT_DATABASE_URL="postgresql://audit_readonly:change_me@localhost:5433/pharma_integrity?schema=public"

# A separate secret from the backend's JWT_SECRET - if the backend process is fully
# compromised, its JWT_SECRET is compromised with it, so this service must be able to
# authenticate its own users without trusting anything the backend signed.
AUDIT_JWT_SECRET=change_me

RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
# Held ONLY here, never on the main backend - see docs/technical-disclosure.md §4.6/§4.9.
AUDITOR_ATTESTOR_PRIVATE_KEY=

# Test-only fixture, NOT read by the app itself - lets tests propose an on-chain
# package to co-sign against (standing in for the main backend). Mirrors backend's
# QA_ATTESTOR_PRIVATE_KEY.
TEST_QA_PRIVATE_KEY=

# Must exactly match the main backend's ANOMALY_* values (see backend/.env.example) -
# this service independently recomputes anomaly-finding hashes from the same reviewer
# history, and a threshold mismatch produces a hash mismatch that looks like a tamper
# finding rather than a config error. Log the resolved values at boot to make drift
# detectable.
# ANOMALY_FAST_APPROVAL_FALLBACK_MS=60000
# ANOMALY_MIN_BASELINE_SAMPLE_SIZE=5
# ANOMALY_FAST_APPROVAL_Z_SCORE_THRESHOLD=-1.5
# ANOMALY_BUSINESS_HOUR_START=8
# ANOMALY_BUSINESS_HOUR_END=18
